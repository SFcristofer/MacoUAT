for (OrderItem a : [SELECT Order.OrderNumber, Order.ZF_Pedido_ID__c, Order.Status, Articulo__c, Quantity, UnitPrice, Tipo_Precio__c, Impuesto_Porcentaje__c, Impuesto__c, Description, Product2.Name, Product2.ProductCode, Product2.Description, Product2.QuantityUnitOfMeasure FROM OrderItem WHERE Order.OrderNumber IN ('00000782','00000783','00000784','00000785')]) System.debug('I|' + JSON.serialize(a));
