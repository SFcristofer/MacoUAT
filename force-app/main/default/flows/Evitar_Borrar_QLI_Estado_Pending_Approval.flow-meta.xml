<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <description>&quot;No se pueden eliminar productos cuando la cotización está pendiente de aprobación.&quot;</description>
        <name>Enviar_Error_Personalizado</name>
        <label>Enviar Error Personalizado</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <customErrorMessages>
            <errorMessage>&quot;No se pueden eliminar productos cuando la cotización está pendiente de aprobación.&quot;</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <description>Trigger Flow para Evitar Eliminación de QLI en Estado &quot;Pending Approval&quot;</description>
    <environments>Default</environments>
    <interviewLabel>Evitar Borrar QLI Estado Pending Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Evitar Borrar QLI Estado Pending Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Enviar_Error_Personalizado</targetReference>
        </connector>
        <filterFormula>ISPICKVAL({!$Record.Quote.Status}, &quot;Pending approval&quot;)</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
