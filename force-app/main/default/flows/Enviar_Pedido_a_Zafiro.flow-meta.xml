    <description>Al confirmar un Pedido se enviará a Zafiro. Se debe recibir el OK de Zafiro del Pedido cargado y un Id Externo que será guardado en el Pedido.</description>
    <environments>Default</environments>
    <formulas>
        <name>ByPass</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Obtener_Order.ByPassValidation__c} = FALSE, TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <name>EvaluarTipoPrecio</name>
        <dataType>Boolean</dataType>
        <expression>NOT(REGEX({!ArticuloInput.Tipo_Precio__c}, &quot;^[0-9]+$&quot;))</expression>
    </formulas>
    <formulas>
        <name>Formula_MethodOfPayment</name>
        <dataType>String</dataType>
        <expression>IF(({!Tipo_Venta}) = &quot;Crédito&quot;, &quot;CR&quot;,
   IF(({!Tipo_Venta}) = &quot;Contado&quot;, &quot;CO&quot;,
 IF(
      {!Contado} = &quot;Contado&quot;, &quot;CO&quot;,
      IF(
        {!Credito} = &quot;Credito&quot;, &quot;CR&quot;,
        &quot;&quot;
      )
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>NowPlus30Seconds</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + (30 / 86400)</expression>
    </formulas>
    <formulas>
        <name>ObtenerEndDate</name>
        <dataType>String</dataType>
        <expression>TEXT(({!Obtener_Order.EndDate}))</expression>
    </formulas>
    <formulas>
        <name>OrderDateIntegration</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR({!Obtener_Order.EffectiveDate})) 
&amp; &quot;-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(MONTH({!Obtener_Order.EffectiveDate})), 2) 
&amp; &quot;-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(DAY({!Obtener_Order.EffectiveDate})), 2)</expression>
    </formulas>
    <formulas>
        <name>TransforArticuloTipoPrecio</name>
        <dataType>Number</dataType>
        <expression>VALUE({!ArticuloInput.Tipo_Precio__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TransformExternalID</name>
        <dataType>Number</dataType>
        <expression>VALUE({!ArticuloInput.Articulo__c})</expression>
        <scale>2</scale>
    </formulas>
