<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>StandardUserMaco</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Standard User Maco</stringValue>
        </value>
    </constants>
    <constants>
        <name>SystemAdministratorMaco</name>
        <dataType>String</dataType>
        <value>
            <stringValue>System Administrator Maco</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Is_Standard_User</name>
        <label>Is Standard User?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YesStandardUser</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>StandardUserMaco</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>SystemAdministratorMaco</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PermissionSetAssignmentDeletion</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>PermissionSetAssignmentDeletion</name>
        <label>Permission Set Assignment/Deletion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>DeleteAdminPermissionSet</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Deletion</defaultConnectorLabel>
        <rules>
            <name>Assignment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetPermissionFromRunningUser</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assing_Admin_Permission_Set</targetReference>
            </connector>
            <label>Assignment</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>NowPlus10Seconds</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + (10 / 86400)</expression>
    </formulas>
    <interviewLabel>Assign Bypass Validation Rule Permission Set {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Assign Bypass Validation Rule Permission Set</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Assing_Admin_Permission_Set</name>
        <label>Assing Admin Permission Set</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AssigneeId</field>
            <value>
                <elementReference>RunningUserId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PermissionSetId</field>
            <value>
                <elementReference>GetAdminPermissionSet.Id</elementReference>
            </value>
        </inputAssignments>
        <object>PermissionSetAssignment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordDeletes>
        <name>DeleteAdminPermissionSet</name>
        <label>Delete Admin Permission Set</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>GetPermissionFromRunningUser</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>GetAdminPermissionSet</name>
        <label>Get Admin Permission Set</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GetPermissionFromRunningUser</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>By_Pass_Validation_Rules</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PermissionSet</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetPermissionFromRunningUser</name>
        <label>Get Permission From Running User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Standard_User</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssigneeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>RunningUserId</elementReference>
            </value>
        </filters>
        <filters>
            <field>PermissionSetId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetAdminPermissionSet.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PermissionSetAssignment</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetAdminPermissionSet</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>RunningUserId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
