    <description>Permitir al usuario ingresar información para crear una Cotización y redirigir automáticamente a la página de la Cotización creada.</description>
    <environments>Default</environments>
    <formulas>
        <name>Date</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>DominioActual</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_530}, FIND(&apos;/services&apos;, {!$Api.Partner_Server_URL_530}))</expression>
    </formulas>
    <formulas>
        <name>FechaActual</name>
        <dataType>String</dataType>
        <expression>TEXT(DAY(TODAY())) &amp; &quot;/&quot; &amp; TEXT(MONTH(TODAY())) &amp; &quot;/&quot; &amp; TEXT(YEAR(TODAY()))</expression>
    </formulas>
    <formulas>
        <name>forAccount</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!Account.recordId}), NULL, {!Account.recordId})</expression>
    </formulas>
    <formulas>
        <name>forQuoteWithoutAccount</name>
        <dataType>Boolean</dataType>
        <expression>IF(ISNULL({!Account.recordId}), TRUE,FALSE)</expression>
    </formulas>
    <formulas>
        <name>NombreCotizacionDefault</name>
        <dataType>String</dataType>
        <expression>&quot;Quote &quot; &amp; &quot; &quot; &amp; {!FechaActual}</expression>
    </formulas>
    <formulas>
        <name>OpptyNameDefault</name>
        <dataType>String</dataType>
        <expression>&quot;Oppty&quot; + &quot; &quot; + {!FechaActual}</expression>
    </formulas>
    <formulas>
        <name>QuoteHyperlink</name>
        <dataType>String</dataType>
        <expression>HYPERLINK(&quot;https://maco--uat.sandbox.lightning.force.com/lightning/r/Quote/&quot; &amp; {!recordId} &amp; &quot;/view&quot;,
    &quot;Ir a la Cotización Creada&quot;,
    &quot;_top&quot;
)</expression>
    </formulas>
    <formulas>
        <name>TodayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>URL</name>
        <dataType>String</dataType>
        <expression>&quot;https://maco--dev.sandbox.lightning.force.com/lightning/r/Quote/recordId/view&quot;</expression>
    </formulas>
    <formulas>
        <name>UrlSalesforce</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_530}, FIND(&apos;/services&apos;, {!$Api.Partner_Server_URL_530}))</expression>
    </formulas>
