<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Se ejecuta de forma asíncrona tras convertir un lead para enviarlo a Zafiro.</description>
    <environments>Default</environments>
    <label>Creacion Cliente Zafiro Prospecto</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>Ejecucion_Asincrona</name>
            <connector>
                <targetReference>Obtener_Cuenta_Convertida</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    
    <recordLookups>
        <name>Obtener_Cuenta_Convertida</name>
        <label>Obtener Cuenta Convertida</label>
        <locationX>300</locationX>
        <locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Crear_Cliente_Zafiro</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ConvertedAccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <actionCalls>
        <name>Crear_Cliente_Zafiro</name>
        <label>Crear Cliente Zafiro</label>
        <locationX>300</locationX>
        <locationY>300</locationY>
        <actionName>CrearClienteEnZafiro</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Ciudad</name>
            <value>
                <elementReference>Obtener_Cuenta_Convertida.BillingCity</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Cp</name>
            <value>
                <elementReference>Obtener_Cuenta_Convertida.BillingPostalCode</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Direccion</name>
            <value>
                <elementReference>Obtener_Cuenta_Convertida.BillingStreet</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Email</name>
            <value>
                <elementReference>Obtener_Cuenta_Convertida.Maildecontacto__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Estado</name>
            <value>
                <elementReference>Obtener_Cuenta_Convertida.BillingState</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Nombre</name>
            <value>
                <elementReference>Obtener_Cuenta_Convertida.Name</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Observaciones</name>
            <value>
                <stringValue>Cliente creado automáticamente por conversión de prospecto</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Pais</name>
            <value>
                <elementReference>Obtener_Cuenta_Convertida.BillingCountry</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Rfc</name>
            <value>
                <elementReference>Obtener_Cuenta_Convertida.RFC__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>SalesforceID</name>
            <value>
                <elementReference>Obtener_Cuenta_Convertida.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>WebSite</name>
            <value>
                <elementReference>Obtener_Cuenta_Convertida.Website</elementReference>
            </value>
        </inputParameters>
        <nameSegment>CrearClienteEnZafiro</nameSegment>
    </actionCalls>
</Flow>
