<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <name>PreventUserModification</name>
        <label>PreventUserModification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>❌ No se puede modificar ni eliminar líneas del presupuesto porque ya fue aprobado y tiene una orden autorizada asociada.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <description>Verify If we got an Order from the previous element.</description>
        <name>AuthorizedOrderNull</name>
        <label>AuthorizedOrderNull?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetAuthorizedOrder</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Standard User Maco</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PreventUserModification</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>This flow prevents users from deleting Quote Line Items when the related Quote is approved and has at least one associated Order in &quot;Authorized&quot; status. It uses entry conditions and custom error messages to enforce this restriction during record updates and deletions.</description>
    <environments>Default</environments>
    <interviewLabel>MACO_ST_Prevent_Deletion_QLI {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MACO_ST_Prevent_Deletion_QLI</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Check if we can retrieve an Authorized Order</description>
        <name>GetAuthorizedOrder</name>
        <label>GetAuthorizedOrder</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>AuthorizedOrderNull</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>QuoteId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Authorized</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Order</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetAuthorizedOrder</targetReference>
        </connector>
        <filterFormula>
ISPICKVAL({!$Record.Quote.Status} ,&quot;Accepted&quot;)</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
