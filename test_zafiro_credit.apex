Account acc = [SELECT Id, ZF_Cliente_ID__c FROM Account WHERE Id = '001WD00000DiCHXYA3']; List<Account> scope = new List<Account>{acc}; SincronizacionCreditoZafiroBatch batch = new SincronizacionCreditoZafiroBatch(); batch.execute(null, scope); Account updatedAcc = [SELECT Limite_de_Credito__c, Saldo__c, Credito_Disponible__c, Plazo_de_Pago__c FROM Account WHERE Id = '001WD00000DiCHXYA3']; System.debug('RESULTADOS DE PRUEBA:'); System.debug('Límite: ' + updatedAcc.Limite_de_Credito__c); System.debug('Saldo: ' + updatedAcc.Saldo__c); System.debug('Disponible: ' + updatedAcc.Credito_Disponible__c); System.debug('Plazo: ' + updatedAcc.Plazo_de_Pago__c);
